# Copy to .env (git-ignored) and change the values. Never commit .env.

# Spring profile: dev locally, prod on Render
SPRING_PROFILES_ACTIVE=dev

# Port on your machine for the app (change it if 8080 is already in use)
APP_PORT=8080

# PostgreSQL (docker compose builds DB_URL from these)
POSTGRES_DB=lifeledger
POSTGRES_USER=lifeledger
POSTGRES_PASSWORD=change-me

# Only needed when running the jar outside docker compose (e.g. ./mvnw spring-boot:run)
DB_URL=jdbc:postgresql://localhost:5432/lifeledger
DB_USERNAME=lifeledger
DB_PASSWORD=change-me

# JWT signing key: at least 32 random characters (e.g. openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# ISO-8601 duration
JWT_EXPIRATION=PT1H
